# ==============================================================================
# Andaman Pearl - Global Infrastructure Environment Variables (.env)
# ==============================================================================

PROJECT_NAME=andaman-pearl

# --- Host Port Configurations ---
# Change these if they conflict with existing services on your Arch Linux host
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
HOST_DB_PORT=5432
HOST_REDIS_PORT=6379
HOST_MAIL_PORT=8025

# --- Database Core Setup (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=andaman_pearl_proj
DB_USERNAME=farook
DB_PASSWORD=1234

# --- Redis Configuration ---
REDIS_HOST=cache-queue
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- Docker Build Args Defaults ---
# These are fallback values if not supplied by the Makefile
HOST_UID=1000
HOST_GID=1000
